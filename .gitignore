# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# local data backups (do not commit)
/backups/

# typescript
*.tsbuildinfo
next-env.d.ts
deploy_log*.txt
deploy_*.txt

# pdfjs-dist worker (copied from node_modules on install/build, see scripts/copy-pdf-worker.mjs)
/public/pdf.worker.min.mjs
